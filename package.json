{
    "name": "joplin-plugin-simple-image-resize",
    "version": "1.9.2",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint . && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint . --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run --passWithNoTests",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^2.0.0",
        "@codemirror/lang-markdown": "^6.5.2",
        "@codemirror/language": "^6.12.3",
        "@codemirror/state": "^6.6.0",
        "@codemirror/view": "^6.42.1",
        "@lezer/common": "^1.5.2",
        "@types/markdown-it": "^13.0.9",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.1.2",
        "eslint-plugin-regexp": "^3.3.3",
        "fallow": "^3.50.0",
        "fallow-type-aware": "^3.50.0",
        "jsdom": "^31.0.1",
        "markdown-it": "13.0.2",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "oxlint-tsgolint": "^7.0.2009",
        "typescript": "^7.0.2",
        "vitest": "^5.1.2"
    },
    "dependencies": {
        "entities": "^9.0.0"
    }
}

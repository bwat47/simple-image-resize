{
    "$schema": "./node_modules/fallow/schema.json",
    "entry": [
        "src/index.ts",
        "src/editor/cursorContentScript.ts",
        "src/viewer/viewerContentScript.ts",
        "src/viewer/viewerContextMenu.js",
        "src/dialog/resizeDialog.ts"
    ],
    "supportEntry": ["tests/**/*.test.ts"],
    "ignorePatterns": ["**/*.d.ts", "api/**"],
    "typeAware": {
        "enabled": true
    },
    "rules": {
        "complexity-crap": "off",
        "dev-dependencies-in-production": "off",
        "test-only-exports": "warn",
        "require-suppression-reason": "error"
    },
    "health": {
        "maxCognitive": 15,
        "maxCyclomatic": 20
    }
}
